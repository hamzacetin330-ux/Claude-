index 7a795a5..e18f972 100644
--- a/Support/SDLMixerCompat.cpp
+++ b/Support/SDLMixerCompat.cpp
@@ -189,12 +189,27 @@ int Mix_OpenAudio(int frequency, SDL_AudioFormat format, int channelCount, int c
 	return Mix_OpenAudioDevice(frequency, format, channelCount, chunksize, nullptr, 0);
 }
 
-int Mix_OpenAudioDevice(int frequency, SDL_AudioFormat format, int channelCount, int /*chunksize*/, const char * /*device*/, int /*allowed_changes*/) {
+int Mix_OpenAudioDevice(int frequency, SDL_AudioFormat format, int channelCount, int chunksize, const char * /*device*/, int /*allowed_changes*/) {
 	Mix_CloseAudio();
 
 	if (!MIX_Init())
 		return -1;
 
+	// SDL3 sizes the device buffer from this hint rather than from a chunk size,
+	// so turn the configured audiobuffer (bytes) into sample frames: in ons.cfg,
+	// audiobuffer=4 / 8 / 16 gives roughly 1024 / 2048 / 4096 frames. Without
+	// that line (chunksize is the engine default of 2048 bytes) Android gets
+	// 2048 frames (~45 ms): SDL's own tiny default underruns on Bluetooth,
+	// heard as constant stutter, while bigger buffers add noticeable delay.
+	int frameBytes = static_cast<int>(SDL_AUDIO_BYTESIZE(format)) * std::max(channelCount, 1);
+	int frames     = frameBytes > 0 ? chunksize / frameBytes : 0;
+#ifdef DROID
+	if (chunksize == 2048)
+		frames = 2048;
+#endif
+	if (frames > 0)
+		SDL_SetHint(SDL_HINT_AUDIO_DEVICE_SAMPLE_FRAMES, std::to_string(frames).c_str());
+
 	SDL_AudioSpec requested{};
 	requested.freq     = frequency;
 	requested.format   = format;
